// KYTY_FAULT_PROCESS_VEC=1: fault_buffer_process.comp over 4 bitmap words per invocation.
// Same contract as fault_buffer_process.comp (FaultManager reads it the same way):
//  - every bitmap word the dispatch covers is zero afterwards;
//  - download_buffer32[0] grows by at least min(set bits, MAX_PAGE_FAULTS - 1), and entries
//    1 .. min(count, MAX_PAGE_FAULTS - 1) each hold one faulting page << CACHING_PAGEBITS, every
//    set page at most once (the order was never defined: atomics hand out the slots).
// Differences that cost the scan time: one 16-byte load per invocation, no store for an all-zero
// quad (almost every quad: the bitmap covers 2^40 bytes), one counter atomic per invocation
// instead of one per set bit.
#version 450
#extension GL_ARB_gpu_shader_int64 : enable

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) buffer input_buf {
    uvec4 fault_quads[];
};

layout(std430, binding = 1) buffer output_buf {
    uint64_t download_buffer[];
};
layout(std430, binding = 1) buffer output_buf32 {
    uint download_buffer32[];
};

void main() {
    const uint id = gl_GlobalInvocationID.x;
    const uvec4 quad = fault_quads[id];
    if ((quad.x | quad.y | quad.z | quad.w) == 0u) {
        return;
    }
    fault_quads[id] = uvec4(0u);
    const uint bits = uint(bitCount(quad.x) + bitCount(quad.y) + bitCount(quad.z) + bitCount(quad.w));
    // Entries first .. first + bits - 1 belong to this invocation (entry 0 is the counter).
    uint store_index = atomicAdd(download_buffer32[0], bits) + 1u;
    for (uint lane = 0u; lane < 4u; ++lane) {
        uint word = quad[lane];
        const uint base_bit = (id * 4u + lane) * 32u;
        while (word != 0u) {
            if (store_index >= MAX_PAGE_FAULTS) {
                return;
            }
            const uint bit = findLSB(word);
            word &= word - 1;
            download_buffer[store_index] = uint64_t(base_bit + bit) << CACHING_PAGEBITS;
            ++store_index;
        }
    }
}
